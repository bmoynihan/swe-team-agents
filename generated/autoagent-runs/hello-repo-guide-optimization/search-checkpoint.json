            "name": "hello-repo-guide",
            "description": "Tiny onboarding example agent used to validate the copilot-agent-converter end-to-end packaging flow.\n",
            "target": [
              "vscode",
              "github-copilot"
            ],
            "tools": [],
            "user-invocable": true,
